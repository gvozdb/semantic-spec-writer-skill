spec
meta:
  file: cursor-pagination.spec.ctx
  title: Canonical opaque cursor pagination
  status: benchmark

terms:
  R: ordered input records list
  enc(n): strip trailing '=' from urlsafe_b64(JSON({"offset":n},sort_keys=true,separators=(',',':')).UTF8)
  dec(c): padded urlsafe_b64 decode + JSON parse

goal:
  G1: return the requested page and canonical next cursor without mutating R

rules:
  R1: R must be list; limit must be int and not bool and 1<=limit<=100; invalid limit -> ValueError "limit must be an integer from 1 to 100"
  R2: cursor=null -> offset=0; otherwise dec(cursor) must be object with exactly {offset}, offset int not bool and >=0; invalid -> ValueError "invalid cursor"
  R3: offset>len(R) -> ValueError "cursor offset is past the end of records"; offset=len(R) is valid
  R4: items=R[offset:min(offset+limit,len(R))] in original order
  R5: end=offset+len(items); next_cursor=enc(end) iff end<len(R), else null; output keys are exactly items,next_cursor
  R6: preserve all inputs

acceptance:
  A1:
    given: an ordered list, valid limit, and optional cursor
    when: paginate is called
    then: output follows R2-R5 and cursor strings are exact enc values
  A2:
    given: invalid limit or cursor
    when: paginate is called
    then: raise the specified ValueError

open_questions: []
