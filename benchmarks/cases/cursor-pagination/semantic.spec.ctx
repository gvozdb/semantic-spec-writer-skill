spec
goal: implement canonical cursor pagination without mutating inputs

scope:
  edit: solution.py
  contract: paginate(records, limit, cursor=None) -> {items,next_cursor}

rules:
  R1: records must be list
  R2: limit must be int, not bool, and 1..100; otherwise ValueError "limit must be an integer from 1 to 100"
  R3: cursor=None -> offset=0
  R4: other cursor -> restore URL-safe Base64 padding, decode UTF-8 JSON, require exactly {"offset": non-negative int-not-bool}; any failure -> ValueError "invalid cursor"
  R5: offset>len(records) -> ValueError "cursor offset is past the end of records"; equality is a valid empty final page
  R6: items=records[offset:offset+limit] with original order and identity
  R7: next_offset=offset+len(items); next_cursor=None when next_offset>=len(records)
  R8: otherwise next_cursor is URL-safe Base64 without trailing `=` of UTF-8 JSON {"offset":next_offset} using sorted keys and separators `(',', ':')`
  R9: output has exactly items,next_cursor; preserve records and nested records

acceptance:
  A1: R3-R9 cover exact cursors, slicing, final/empty pages, and input preservation
  A2: R1,R2,R4,R5 cover validation and exact errors
