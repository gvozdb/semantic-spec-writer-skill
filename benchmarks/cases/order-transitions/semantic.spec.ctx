spec
goal: apply deterministic order lifecycle events without mutating inputs

scope:
  edit: solution.py
  contract: apply_order_event(order, event) -> success|error

transitions:
  pending: pay->paid, cancel->cancelled
  paid: pack->packed, cancel->cancelled, refund->refunded
  packed: ship->shipped, refund->refunded
  shipped: deliver->delivered, refund->refunded
  delivered,cancelled,refunded: no outgoing transitions

rules:
  R1: event["type"] outside pay/pack/ship/deliver/cancel/refund -> exactly {ok:false,error:"unknown_event",event:event_type}
  R2: known event disallowed from order["status"] -> exactly {ok:false,error:"invalid_transition",status:current_status,event:event_type}
  R3: check R2 before event payload
  R4: allowed pay requires trimmed non-empty string event["payment_id"]; otherwise exactly {ok:false,error:"missing_payment_id"}; store trimmed value as updated_order["payment_id"]
  R5: allowed ship requires trimmed non-empty string event["tracking_number"]; otherwise exactly {ok:false,error:"missing_tracking_number"}; store trimmed value as updated_order["tracking_number"]
  R6: success -> exactly {ok:true,order:updated_order}; updated_order is deep copy with new status, R4/R5 value when relevant, and every unrelated field retained
  R7: ignore other event fields; add no generated values; preserve order and event for success/errors

acceptance:
  A1: transitions,R1-R3 implement every allowed edge and deterministic rejection
  A2: R4-R7 normalize identifiers and retain arbitrary nested order data
  A3: R1,R2,R4-R7 preserve inputs and exact success/error shapes
