spec
goal: build deterministic capped exponential retry delays without mutating inputs

scope:
  edit: solution.py
  contract: build_retry_schedule(attempts, base_delay, max_delay, retry_after=None) -> list[int]

rules:
  R1: required arguments must be non-negative int-not-bool; retry_after is None or non-negative int-not-bool
  R2: wrong type -> TypeError "<name> must be an integer"; negative -> ValueError "<name> must be non-negative"; validate even when attempts=0
  R3: attempts=0 -> []
  R4: for zero-based retry index i, delay=min(max_delay,max(base_delay*2**i,retry_after if present else 0))
  R5: return one delay per retry in index order; cap wins when retry_after>max_delay; exclude initial attempt and metadata

acceptance:
  A1: R3-R5 cover zero attempts/base, cap below base, and retry_after lower bound
  A2: R1,R2 cover exact type and non-negative errors
