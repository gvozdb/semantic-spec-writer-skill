spec
goal: validate timestamped HMAC webhook signatures without mutating inputs

scope:
  edit: solution.py
  contract: validate_webhook(payload, signature_header, secret, now, tolerance=300) -> exactly {valid,reason}

rules:
  R1: secret is non-empty string; signature_header is string; now/tolerance are int-not-bool; tolerance>=0; otherwise malformed
  R2: split header by comma and trim components, keys, values; every component has `=`; require exactly one non-empty ASCII-decimal t and at least one v1
  R3: every v1 is exactly 64 lowercase hex; duplicate t or any R2/R3 failure -> malformed; ignore other well-formed keys
  R4: timestamp=int(t); abs(now-timestamp)>tolerance -> expired; equality is accepted
  R5: canonical body = UTF-8 JSON of payload with sorted keys, no spaces via separators `(',', ':')`, ensure_ascii=False
  R6: signed bytes = ASCII timestamp + `.` + canonical body; expected signature = lowercase hex HMAC-SHA256 using UTF-8 secret
  R7: compare expected signature with every v1 using constant-time comparison; any match -> {valid:true,reason:"ok"}; otherwise mismatch
  R8: malformed/expired/mismatch -> {valid:false,reason:<reason>}; use no clock, randomness, or network

acceptance:
  A1: R4-R7 cover exact canonicalization, current timestamps, rotated signatures, and HMAC success
  A2: R1-R4,R7,R8 cover malformed headers, stale timestamps, and current mismatches
