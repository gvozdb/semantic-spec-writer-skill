spec
goal: reserve inventory atomically without mutating either input

scope:
  edit: solution.py
  contract: reserve_inventory(inventory, request) -> success|failure

rules:
  R1: inventory is an object mapping case-sensitive SKU keys to non-negative int-not-bool stock
  R2: trim reservation_id and every requested SKU; both must remain non-empty strings; quantity is positive int-not-bool
  R3: items must be list of objects; combine repeated trimmed SKUs and preserve first-seen distinct order
  R4: missing SKU availability=0; succeed only when every aggregate quantity is available
  R5: success -> exactly {ok:true,reservation_id,inventory,reserved}; inventory is a full copy with aggregates subtracted; reserved=[{sku,quantity}] in first-seen order
  R6: failure -> exactly {ok:false,reservation_id,inventory,shortages}; inventory is unchanged copy; shortages=[{sku,requested,available}] for insufficient SKUs in first-seen order; no reserved and no partial decrement
  R7: empty items -> successful no-op

errors:
  inventory shape: ValueError "inventory must be an object"
  stock: ValueError "inventory quantities must be non-negative integers"
  reservation_id: ValueError "reservation_id must be a non-empty string"
  items: ValueError "items must be a list"
  item: ValueError "each item must be an object"
  sku: ValueError "sku must be a non-empty string"
  quantity: ValueError "quantity must be a positive integer"

acceptance:
  A1: R2,R3 preserve normalization, aggregation, case sensitivity, and order
  A2: R4-R6 enforce all-or-nothing reservation and complete shortage reporting
  A3: R1,R2,R5-R7 and errors preserve inputs, exact shapes, keys, and messages
