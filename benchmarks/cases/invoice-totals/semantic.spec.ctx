spec
goal: calculate invoice totals in integer cents without mutating input

scope:
  edit: solution.py
  contract: calculate_invoice(invoice) -> exact totals object

rules:
  R1: invoice["items"] is list; each quantity is positive int-not-bool; each unit_price_cents is non-negative int-not-bool
  R2: absent discount_cents, shipping_cents, tax_rate_bps -> 0; discount/shipping are non-negative int-not-bool; tax rate is int-not-bool in 0..10000
  R3: line_totals_cents=[quantity*unit_price_cents] in item order; subtotal_cents=sum(line totals)
  R4: discount_cents=min(input discount,subtotal_cents); taxable_cents=subtotal_cents-discount_cents
  R5: tax excludes shipping and rounds half-cent upward: tax_cents=(taxable_cents*tax_rate_bps+5000)//10000
  R6: total_cents=taxable_cents+tax_cents+shipping_cents
  R7: output exactly line_totals_cents,subtotal_cents,discount_cents,taxable_cents,tax_cents,shipping_cents,total_cents; all integers; empty items valid
  R8: preserve invoice and nested item objects; never use floating point

errors:
  items: ValueError "items must be a list"
  quantity: ValueError "quantity must be a positive integer"
  unit price: ValueError "unit_price_cents must be a non-negative integer"
  discount: ValueError "discount_cents must be a non-negative integer"
  shipping: ValueError "shipping_cents must be a non-negative integer"
  tax rate: ValueError "tax_rate_bps must be an integer from 0 to 10000"

acceptance:
  A1: R3-R6 implement lines, capped discount, exact half-up tax, and total
  A2: R2,R5 cover defaults and untaxed shipping
  A3: R1,R7,R8 and errors cover exact output, validation, and input preservation
