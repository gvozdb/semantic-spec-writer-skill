spec
goal: idempotent refund workflow; preserve all inputs/unrelated order fields
entrypoint: solution.py -> execute_refund

route:
  edit: billing/ledger.py::def find_by_key
    do: find_by_key -> deep copy first entry matching account_id + trimmed key, else None
    do: append_entry -> deep-copy list and appended entry
  edit: billing/events.py::def build_refund_event
    do: return exactly {type:"refund.created",account_id,order_id,refund_id,amount_cents,reason:trimmed_reason}; preserve entry
  edit: billing/service.py::def execute_refund
    do: validate key,refund_id,reason as trimmed non-empty strings; amount type int not bool and >0; errors invalid_key|invalid_refund_id|invalid_reason|invalid_amount
    do: then status in [paid,shipped] else order_not_refundable; then amount<=paid_cents-refunded_cents else amount_exceeds_remaining; every error exactly {ok:false,error}
    do: then scoped account_id+key lookup; existing["order_id"]==order["id"] and same refund_id,amount -> replay; mismatch -> exactly {ok:false,error:"idempotency_conflict"}
    do: new entry exactly {account_id:order["account_id"],order_id:order["id"],key,refund_id,amount_cents}; deep-copy order and increment refunded_cents; append entry + one event
    do: success exactly {ok:true,replayed:false,refund:entry,order,ledger,events}; replay same keys with replayed:true and unchanged deep copies
  expand: edit all targets; inspect routed files first; expand only on code/import contradiction

basis: route-sha256:ccf6b5f55ed2ea9296e7432a58fb944ca105972a250db8bd55eede649c88e091
keep: no mutation,timestamps,generated identifiers; retain arbitrary nested fields

verify:
  V1: `python3 -m unittest -q test_smoke.py`

acceptance:
  A1: validation order/errors
  A2: scoped replay/conflict
  A3: ledger/event helpers and input preservation
  A4: exact success shapes
